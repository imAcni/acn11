---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import {
  getStatusData,
  getStatusTypeClass,
  type StatusEntry,
} from "@/utils/status";

export const prerender = false;

const posts = await getCollection("blog");
const statusData = await getStatusData();
const currentStatus = statusData.current;

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const formatStatusDate = (status: StatusEntry) =>
  status.updatedAt
    ? new Intl.DateTimeFormat("en-US", {
        dateStyle: "medium",
        timeStyle: "short",
        timeZone: SITE.timezone,
      }).format(status.updatedAt)
    : "not set";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        acni
      </h1>
      {
        currentStatus && (
          <div class="mt-[-0.75rem] mb-5 max-w-2xl">
            <p
              class:list={[
                "text-sm leading-6 sm:text-base",
                getStatusTypeClass(currentStatus.type),
              ]}
            >
              <span class="text-foreground/60">status: </span>
              {currentStatus.parts.map(part =>
                part.type === "link" ? (
                  <a
                    href={part.href}
                    target="_blank"
                    rel="noreferrer"
                    class="underline decoration-accent/60 underline-offset-4 hover:text-accent"
                  >
                    {part.text}
                  </a>
                ) : (
                  part.text
                )
              )}
            </p>
            <p class="mt-1 text-xs text-foreground/60">
              last updated: {formatStatusDate(currentStatus)}
              <span aria-hidden="true"> · </span>
              <a
                href="/statuses/"
                class="underline decoration-accent/60 underline-offset-4 hover:text-accent"
              >
                past statuses
              </a>
            </p>
          </div>
        )
      }
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Hey, I'm tyler. I'm a highschooler, CTF player, and cybersecurity
        student. I blogpost about interesting binary exploitation concepts and
        open-source intelligence challenges.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0" />
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
